# ============================================================
# DATOS PRIVADOS
# Ignorar el contenido, pero conservar carpetas y documentación
# ============================================================

datos/**
Procesados/**
documentos/**

# Permitir los directorios
!datos/**/
!Procesados/**/
!documentos/**/

# Permitir archivos utilizados para conservar/documentar la estructura
!datos/**/.gitkeep
!datos/**/README.md
!Procesados/**/.gitkeep
!Procesados/**/README.md
!documentos/**/.gitkeep
!documentos/**/README.md


# ============================================================
# RESULTADOS
# Se conservan los informes Markdown, figuras y resúmenes
# agregados. Se excluyen resultados a nivel de animal.
# ============================================================

# Asignaciones y resúmenes individuales por vaca
resultados/**/*_por_vaca.csv

# Proyecciones fila a fila: contienen cow_id y window_start
resultados/**/*_proyeccion.csv

# Eventos individualizados de Valdillera
resultados/valdillera/resumen_eventos_por_vaca.csv

# Archivos parciales utilizados durante la ejecución
resultados/**/_partial_*.json

# Resultados exploratorios antiguos
resultados/legacy/

# Las figuras finales del TFM se guardan aparte y sí se suben:
# Figuras/Resultados/




# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyd

# Jupyter
.ipynb_checkpoints/

# Herramientas y caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Sistema y editores
.DS_Store
Thumbs.db
*.swp
*~

# Logs y temporales
*.log
*.tmp
